# =============================================================================
# Heimdall SIEM - Environment Configuration
# =============================================================================
# Copy this file to .env and fill in the values for your deployment.
# Place .env in the project root or heimdall/ directory.
#
# Variables with defaults listed can be omitted if the default is acceptable.
# Variables with no default MUST be set for the system to function correctly.
# =============================================================================


# -----------------------------------------------------------------------------
# REQUIRED: Security Secrets
# Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
# -----------------------------------------------------------------------------
JWT_SECRET=
REFRESH_TOKEN_SECRET=


# -----------------------------------------------------------------------------
# REQUIRED: Bootstrap Admin User
# Creates the initial admin account on first startup (only if user doesn't exist).
# Can be safely removed from .env after the first successful login.
# -----------------------------------------------------------------------------
BOOTSTRAP_ADMIN_USER=admin
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_ROLE=admin


# -----------------------------------------------------------------------------
# MongoDB
# -----------------------------------------------------------------------------
MONGO_URI=mongodb://localhost:27017


# -----------------------------------------------------------------------------
# Suricata
# -----------------------------------------------------------------------------
SURICATA_LOG_DIR=/var/log/suricata
SURICATA_LOG_TYPE=eve.json          # eve.json or fast.log
SURICATA_IFACE=enp0s3               # Network interface Suricata monitors
SURICATA_CONFIG=/etc/suricata/suricata.yaml


# -----------------------------------------------------------------------------
# Sensor Identity
# Used to tag every collected event with its source sensor.
# -----------------------------------------------------------------------------
HEIMDALL_SENSOR_ID=sensor-1
# HEIMDALL_SENSOR_HOSTNAME=          # Defaults to system hostname if unset


# -----------------------------------------------------------------------------
# Incident Management
# -----------------------------------------------------------------------------
INCIDENT_TIMEOUT_MINUTES=120        # Auto-close inactive incidents after N minutes
CORRELATION_RULES_PATH=./correlation_rules.json


# -----------------------------------------------------------------------------
# JWT Token Lifetimes
# -----------------------------------------------------------------------------
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=10
JWT_ISSUER=heimdall


# -----------------------------------------------------------------------------
# Rate Limiting (requests per minute per IP)
# -----------------------------------------------------------------------------
AUTH_RATE_LIMIT_PER_MIN=8
AUTH_REFRESH_RATE_LIMIT_PER_MIN=12


# -----------------------------------------------------------------------------
# Remote Agent Ingestion
# AGENT_SHARED_SECRET must match the secret configured on each remote agent.
# -----------------------------------------------------------------------------
AGENT_SHARED_SECRET=
AGENT_MAX_BATCH_SIZE=200
AGENT_MAX_CLOCK_SKEW_SECONDS=300
AGENT_NONCE_TTL_SECONDS=900
AGENT_RATE_LIMIT_PER_MIN=120


# -----------------------------------------------------------------------------
# Jira Integration (optional)
# Enabled automatically when JIRA_BASE_URL and JIRA_API_TOKEN are both set.
# -----------------------------------------------------------------------------
# JIRA_BASE_URL=https://your-org.atlassian.net
# JIRA_EMAIL=you@example.com
# JIRA_API_TOKEN=
# JIRA_PROJECT_KEY=HEIMDALL
# JIRA_ISSUE_TYPE=Security Incident
#
# Optional custom field IDs (Jira field IDs, e.g. customfield_10001):
# JIRA_FIELD_HEIMDALL_ID=
# JIRA_FIELD_SOURCE_IPS=
# JIRA_FIELD_EVENT_COUNT=


# -----------------------------------------------------------------------------
# Slack Integration (optional)
# Enabled automatically when SLACK_WEBHOOK_URL is set.
# -----------------------------------------------------------------------------
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...
# SLACK_CHANNEL=                     # Leave unset to post to the webhook's default channel


# -----------------------------------------------------------------------------
# Integration Filtering
# Minimum incident severity to trigger Jira/Slack notifications.
# Values: low | medium | high | critical
# -----------------------------------------------------------------------------
INTEGRATION_MIN_PRIORITY=medium
